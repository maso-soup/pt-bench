{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run_spec",
  "type": "object",
  "required": ["target_url", "scope", "workdir"],
  "properties": {
    "target_url": { "type": "string" },
    "scope": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "budget": {
      "type": "object",
      "properties": {
        "tool_calls": { "type": ["integer", "null"] },
        "usd": { "type": ["number", "null"] },
        "wall_time_s": { "type": ["integer", "null"] }
      }
    },
    "workdir": { "type": "string" },
    "extra": { "type": "object" }
  }
}
